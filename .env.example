# ── Robot
ROBOT_IP=192.168.100.141
ROBOT_PORT=5100
ROBOT_VOLUME=0.8

# ── Speech Recognition
# true = dùng mic PC (Google STT, hỗ trợ tiếng Việt)
# false = dùng mic robot (chỉ tiếng Anh)
USE_LOCAL_STT=true
LOCAL_STT_LANGUAGE=vi-VN
LISTEN_TIMEOUT_MS=10000
MAX_RETRY_LISTEN=2

# ── Q&A
# Level: 5 = Rule-based, 10 = LLM
QA_LEVEL=5

# LLM Provider: "openai" hoặc "gemini"
LLM_PROVIDER=gemini
LLM_API_KEY=your-api-key-here

# Tuỳ chỉnh model (mặc định đã có trong config.py)
# LLM_MODEL_OPENAI=gpt-4o-mini
# LLM_MODEL_GEMINI=gemini-2.0-flash
